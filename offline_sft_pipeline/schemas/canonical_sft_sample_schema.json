{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical_sft_sample_schema.json",
  "title": "CanonicalSftSample",
  "description": "Canonical linearized SFT sample exported from one terminal trajectory before final LLaMA-Factory conversion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "source_trajectory_id",
    "source_status",
    "export_timestamp",
    "thinking_enabled",
    "tools",
    "artifacts",
    "messages",
    "final_answer",
    "judge_summary",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "source_trajectory_id": {
      "type": "string",
      "minLength": 1
    },
    "source_status": {
      "type": "string",
      "enum": [
        "answered",
        "pruned",
        "failed",
        "stopped_early",
        "max_step_reached",
        "error"
      ]
    },
    "export_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "thinking_enabled": {
      "type": "boolean"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolSpec"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "final_answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "judge_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_score",
        "weak_model_solved_count"
      ],
      "properties": {
        "overall_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "weak_model_solved_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "toolSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "role",
        "content",
        "image_artifact_ids",
        "metadata"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "string"
        },
        "image_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
